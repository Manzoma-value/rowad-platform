model AssessmentAnswer {
  id          String             @id @default(uuid()) @db.Uuid
  attempt_id  String             @db.Uuid
  question_id String             @db.Uuid
  answer      String
  is_correct  Boolean?
  created_at  DateTime           @default(now())
  attempt     AssessmentAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question    AssessmentQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("assessment_answers")
}

model Roadmap {
  id         String         @id @default(uuid()) @db.Uuid
  school_id  String         @unique @db.Uuid
  title      String         @default("بنك الأسئلة")
  created_at DateTime       @default(now())
  stages     RoadmapStage[]
  school     School         @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@map("roadmaps")
}

model RoadmapStage {
  id               String          @id @default(uuid()) @db.Uuid
  roadmap_id       String          @db.Uuid
  title            String
  qualification_ar String?
  qualification_sq String?
  order            Int
  created_at       DateTime        @default(now())
  modules          RoadmapModule[]
  roadmap          Roadmap         @relation(fields: [roadmap_id], references: [id], onDelete: Cascade)
  traits           StageTrait[]

  @@map("roadmap_stages")
}

model RoadmapModule {
  id               String            @id @default(uuid()) @db.Uuid
  stage_id         String            @db.Uuid
  title            String
  description      String?
  order            Int
  created_at       DateTime          @default(now())
  stage            RoadmapStage      @relation(fields: [stage_id], references: [id], onDelete: Cascade)
  contents         ModuleContent[]
  questions        RoadmapQuestion[]
  attempts         ModuleAttempt[]
  main_trait_id    String?           @db.Uuid
  main_trait       StageTrait?       @relation("ModuleMainTrait", fields: [main_trait_id], references: [id])
  trait_links      ModuleTraitLink[]
  traitAssessments TraitAssessment[]
  // Teacher-authored content tied to this concept
  lessons          Lesson[]          @relation("ModuleLessons")
  quizzes          Quiz[]            @relation("ModuleQuizzes")

  @@map("roadmap_modules")
}

// A concept can activate several traits, and every trait can be developed by
// several concepts. This replaces the old single, pre-weighted main trait in
// the UI while retaining main_trait_id temporarily for historical data.
model ModuleTraitLink {
  module_id   String  @db.Uuid
  trait_id    String  @db.Uuid
  position    Int     @default(0)
  guidance_ar String?
  guidance_sq String?

  module RoadmapModule @relation(fields: [module_id], references: [id], onDelete: Cascade)
  trait  StageTrait    @relation(fields: [trait_id], references: [id], onDelete: Cascade)

  @@id([module_id, trait_id])
  @@index([trait_id])
  @@map("module_trait_links")
}

model ModuleContent {
  id           String        @id @default(uuid()) @db.Uuid
  module_id    String        @db.Uuid
  type         ContentType
  order        Int
  body         String?
  storage_path String?
  image_url    String?
  alt_text     String?
  video_url    String?
  video_title  String?
  created_at   DateTime      @default(now())
  module       RoadmapModule @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@map("module_contents")
}

model RoadmapQuestion {
  id             String                  @id @default(uuid()) @db.Uuid
  module_id      String                  @db.Uuid
  type           QuestionType
  text           String
  correct_answer String?
  order          Int
  created_at     DateTime                @default(now())
  module         RoadmapModule           @relation(fields: [module_id], references: [id], onDelete: Cascade)
  options        RoadmapQuestionOption[]
  matching_pairs MatchingPair[]
  answers        ModuleAnswer[]

  @@map("roadmap_questions")
}

model RoadmapQuestionOption {
  id          String          @id @default(uuid()) @db.Uuid
  question_id String          @db.Uuid
  text        String
  order       Int
  question    RoadmapQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("roadmap_question_options")
}

model MatchingPair {
  id          String          @id @default(uuid()) @db.Uuid
  question_id String          @db.Uuid
  left        String
  right       String
  order       Int
  question    RoadmapQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("matching_pairs")
}

model ModuleAttempt {
  id         String         @id @default(uuid()) @db.Uuid
  module_id  String         @db.Uuid
  student_id String         @db.Uuid
  score      Int
  total      Int
  passed     Boolean
  created_at DateTime       @default(now())
  module     RoadmapModule  @relation(fields: [module_id], references: [id], onDelete: Cascade)
  student    Student        @relation(fields: [student_id], references: [id], onDelete: Cascade)
  answers    ModuleAnswer[]

  @@unique([module_id, student_id])
  @@map("module_attempts")
}

model ModuleAnswer {
  id          String          @id @default(uuid()) @db.Uuid
  attempt_id  String          @db.Uuid
  question_id String          @db.Uuid
  answer      String
  is_correct  Boolean
  attempt     ModuleAttempt   @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question    RoadmapQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("module_answers")
}

model Post {
  id          String   @id @default(uuid()) @db.Uuid
  school_id   String   @db.Uuid
  author_id   String   @db.Uuid // profile.id
  content     String? // text (nullable if image only)
  image_url   String? // Supabase Storage public URL
  image_path  String? // Supabase Storage path (for deletion)
  reply_to_id String?  @db.Uuid // null = top-level post
  created_at  DateTime @default(now())

  school    School         @relation(fields: [school_id], references: [id], onDelete: Cascade)
  author    Profile        @relation(fields: [author_id], references: [id], onDelete: Cascade)
  reply_to  Post?          @relation("PostReplies", fields: [reply_to_id], references: [id], onDelete: Cascade)
  replies   Post[]         @relation("PostReplies")
  reactions PostReaction[]

  @@map("posts")
}

model PostReaction {
  id        String       @id @default(uuid()) @db.Uuid
  post_id   String       @db.Uuid
  author_id String       @db.Uuid
  type      ReactionType

  post   Post    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@unique([post_id, author_id]) // one reaction per user per post
  @@map("post_reactions")
}

enum ReactionType {
  LIKE
  LOVE
  DISLIKE
  HAHA
  SAD
}

// ─────────────────────────────────────────────────────────────
// LESSONS — teacher-authored class lessons with content + Qs
// ─────────────────────────────────────────────────────────────

model Lesson {
  id             String              @id @default(uuid()) @db.Uuid
  teacher_id     String              @db.Uuid
  school_id      String              @db.Uuid
  class_id       String              @db.Uuid
  // Concept (RoadmapModule) the lesson is tied to. Required for NEW lessons.
  // Existing pre-milestone lessons are backfilled to NULL + is_legacy=true.
  module_id      String?             @db.Uuid
  title          String
  description    String?
  // Kept for backwards compat; new visibility is review_status==APPROVED.
  is_published   Boolean             @default(false)
  // Review pipeline
  review_status  ContentReviewStatus @default(DRAFT)
  reviewer_id    String?             @db.Uuid
  reviewer_notes String?
  submitted_at   DateTime?
  reviewed_at    DateTime?
  // Pre-milestone lessons hidden from students; teacher sees as read-only.
  is_legacy      Boolean             @default(false)
  // true  = graded mode (one attempt, score recorded)
  // false = practice mode (instant feedback, retryable, no grade)
  is_graded      Boolean             @default(true)
  linked_quiz_id String?             @db.Uuid
  order          Int                 @default(0)
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt

  teacher     Teacher          @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  school      School           @relation(fields: [school_id], references: [id], onDelete: Cascade)
  class       Class            @relation(fields: [class_id], references: [id], onDelete: Cascade)
  module      RoadmapModule?   @relation("ModuleLessons", fields: [module_id], references: [id], onDelete: SetNull)
  reviewer    Profile?         @relation("LessonReviewedBy", fields: [reviewer_id], references: [id])
  linked_quiz Quiz?            @relation(fields: [linked_quiz_id], references: [id], onDelete: SetNull)
  contents    LessonContent[]
  questions   LessonQuestion[]
  attempts    LessonAttempt[]

  @@index([teacher_id])
  @@index([class_id, is_published])
  @@index([module_id, review_status])
  @@index([school_id, review_status])
  @@map("lessons")
}

model LessonContent {
  id           String      @id @default(uuid()) @db.Uuid
  lesson_id    String      @db.Uuid
  type         ContentType
  order        Int
  // TEXT-only fields. Body can include inline markdown-like formatting
  // (**bold**, __highlight__, etc.) rendered by the lesson viewer.
  body         String?
  // IMAGE-only fields
  storage_path String?
  image_url    String?
  alt_text     String?
  // VIDEO-only fields
  video_url    String?
  video_title  String?
  created_at   DateTime    @default(now())

  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([lesson_id, order])
  @@map("lesson_contents")
}

model LessonQuestion {
  id             String       @id @default(uuid()) @db.Uuid
  lesson_id      String       @db.Uuid
  type           QuestionType
  text           String
  correct_answer String?
  order          Int
  created_at     DateTime     @default(now())

  lesson         Lesson                 @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  options        LessonQuestionOption[]
  matching_pairs LessonMatchingPair[]
  answers        LessonAnswer[]

  @@index([lesson_id, order])
  @@map("lesson_questions")
}

model LessonQuestionOption {
  id          String         @id @default(uuid()) @db.Uuid
  question_id String         @db.Uuid
  text        String
  order       Int
  question    LessonQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("lesson_question_options")
}

model LessonMatchingPair {
  id          String         @id @default(uuid()) @db.Uuid
  question_id String         @db.Uuid
  left        String
  right       String
  order       Int
  question    LessonQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("lesson_matching_pairs")
}

model LessonAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  lesson_id    String    @db.Uuid
  student_id   String    @db.Uuid
  score        Int?
  total        Int?
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  lesson  Lesson         @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [student_id], references: [id], onDelete: Cascade)
  answers LessonAnswer[]

  @@unique([lesson_id, student_id])
  @@map("lesson_attempts")
}

model LessonAnswer {
  id          String   @id @default(uuid()) @db.Uuid
  attempt_id  String   @db.Uuid
  question_id String   @db.Uuid
  answer      String
  is_correct  Boolean?
  created_at  DateTime @default(now())

  attempt  LessonAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question LessonQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("lesson_answers")
}

enum Role {
  OWNER
  SCHOOL_ADMIN
  TEACHER
  STUDENT
}

enum QuestionType {
  MCQ
  TF
  WRITTEN
  MATCHING
}

enum ContentType {
  TEXT
  IMAGE
  VIDEO
}

enum StudentOnboardingStatus {
  PENDING_INTAKE
  INTAKE_SUBMITTED
  SCHOOL_ASSIGNED
  SCHOOL_PLACEMENT_SUBMITTED
  CLASS_ASSIGNED
}

enum AssessmentType {
  PLATFORM_INTAKE
  SCHOOL_PLACEMENT
}

enum AssessmentReviewStatus {
  PENDING
  REVIEWED
}

// ─── Workshops — in-person training sessions with:
//     (1) a permanent signup QR that teachers scan to create an account
//     (2) a fresh attendance QR per day that teachers scan to check in.
enum WorkshopStatus {
  OPEN
  CLOSED
}

enum WorkshopEnrollmentSource {
  QR
  MANUAL
  REQUEST
}

enum WorkshopEnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
}

enum WorkshopAttendanceSource {
  QR
  MANUAL
}

model Workshop {
  id               String         @id @default(uuid()) @db.Uuid
  school_id        String         @db.Uuid
  title            String
  description      String?
  audience         String[]       @default(["TEACHERS"])
  audience_other   String?
  start_date       DateTime?      @db.Date
  end_date         DateTime?      @db.Date
  // Ordered entries: [{date,type:"WORK"|"REST",start_time?,end_time?,label?}]
  schedule         Json           @default("[]")
  notes            String?
  // Ordered entries: [{id,type:"FILE"|"IMAGE"|"VIDEO"|"LINK",title,url,path?,mime?,size?}]
  materials        Json           @default("[]")
  status           WorkshopStatus @default(OPEN)
  // School-admin controlled display order on the workshop management page.
  sort_order       Int            @default(0)
  // Operational state: registration can remain OPEN while the session is
  // explicitly marked live by an admin during the lecture/training.
  is_live          Boolean        @default(false)
  live_started_at  DateTime?
  live_ended_at    DateTime?
  // Public random slug used in the signup URL and encoded in the signup QR.
  // Kept unique globally so /workshop/[token] doesn't need the school in the URL.
  signup_token     String         @unique
  // Permanent attendance URL token. The scan date is resolved at check-in time,
  // so one printed QR serves every scheduled work day in this workshop.
  attendance_token String?        @unique
  created_by       String         @db.Uuid
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  school             School                   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  author             Profile                  @relation("WorkshopAuthor", fields: [created_by], references: [id])
  signed_up_teachers Teacher[]                @relation("WorkshopSignedUpTeachers")
  enrollments        WorkshopEnrollment[]
  attendance         WorkshopAttendance[]
  attendance_codes   WorkshopAttendanceCode[]
  messages           WorkshopMessage[]
  videos             WorkshopVideo[]
  requirements       WorkshopRequirement[]
  completion_records WorkshopCompletion[]

  @@index([school_id, created_at(sort: Desc)])
  @@index([school_id, sort_order])
  @@map("workshops")
}

model WorkshopEnrollment {
  id          String                   @id @default(uuid()) @db.Uuid
  workshop_id String                   @db.Uuid
  teacher_id  String                   @db.Uuid
  source      WorkshopEnrollmentSource @default(QR)
  // Defaults to APPROVED so every existing row, and the still-instant QR/
  // manual-add paths, keep granting access with zero code changes. Only the
  // in-app "Request to Join" path (source=REQUEST) creates a PENDING row.
  status      WorkshopEnrollmentStatus @default(APPROVED)
  enrolled_by String?                  @db.Uuid
  enrolled_at DateTime                 @default(now())
  decided_by  String?                  @db.Uuid
  decided_at  DateTime?

  workshop Workshop @relation(fields: [workshop_id], references: [id], onDelete: Cascade)
  teacher  Teacher  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  author   Profile? @relation("WorkshopEnrollmentAuthor", fields: [enrolled_by], references: [id], onDelete: SetNull)
  decider  Profile? @relation("WorkshopEnrollmentDecider", fields: [decided_by], references: [id], onDelete: SetNull)

  @@unique([workshop_id, teacher_id])
  @@index([teacher_id, enrolled_at(sort: Desc)])
  @@map("workshop_enrollments")
}

model WorkshopMessage {
  id          String   @id @default(uuid()) @db.Uuid
  workshop_id String   @db.Uuid
  author_id   String   @db.Uuid
  body        String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  workshop Workshop @relation(fields: [workshop_id], references: [id], onDelete: Cascade)
  author   Profile  @relation("WorkshopMessageAuthor", fields: [author_id], references: [id], onDelete: Cascade)

  @@index([workshop_id, created_at])
  @@map("workshop_messages")
}

enum WorkshopRequirementType {
  VIDEO
  QUIZ
  MESSAGE
  READING
}

model WorkshopRequirement {
  id          String                  @id @default(uuid()) @db.Uuid
  workshop_id String                  @db.Uuid
  type        WorkshopRequirementType
  title       String
  description String?
  order       Int                     @default(0)
  is_required Boolean                 @default(true)
  min_length  Int                     @default(1)
  created_by  String                  @db.Uuid
  created_at  DateTime                @default(now())
  updated_at  DateTime                @updatedAt

  workshop    Workshop                        @relation(fields: [workshop_id], references: [id], onDelete: Cascade)
  author      Profile                         @relation("WorkshopRequirementAuthor", fields: [created_by], references: [id])
  quiz        WorkshopQuiz?
  completions WorkshopRequirementCompletion[]

  @@index([workshop_id, order])
  @@map("workshop_requirements")
}

model WorkshopQuiz {
  id             String   @id @default(uuid()) @db.Uuid
  requirement_id String   @unique @db.Uuid
  title          String
  description    String?
  passing_score  Int      @default(70)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  requirement WorkshopRequirement    @relation(fields: [requirement_id], references: [id], onDelete: Cascade)
  questions   WorkshopQuizQuestion[]
  attempts    WorkshopQuizAttempt[]

  @@map("workshop_quizzes")
}

enum WorkshopQuizQuestionType {
  MCQ
  TF
  TEXT
}

model WorkshopQuizQuestion {
  id             String                   @id @default(uuid()) @db.Uuid
  quiz_id        String                   @db.Uuid
  type           WorkshopQuizQuestionType
  text           String
  correct_answer String?
  order          Int                      @default(0)
  created_at     DateTime                 @default(now())

  quiz    WorkshopQuiz                 @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  options WorkshopQuizQuestionOption[]
  answers WorkshopQuizAnswer[]

  @@index([quiz_id, order])
  @@map("workshop_quiz_questions")
}

model WorkshopQuizQuestionOption {
  id          String @id @default(uuid()) @db.Uuid
  question_id String @db.Uuid
  text        String
  order       Int    @default(0)

  question WorkshopQuizQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("workshop_quiz_question_options")
}

model WorkshopQuizAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  quiz_id      String    @db.Uuid
  teacher_id   String    @db.Uuid
  score        Int       @default(0)
  total        Int       @default(0)
  completed_at DateTime?
  passed_at    DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  quiz    WorkshopQuiz         @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  teacher Teacher              @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  answers WorkshopQuizAnswer[]

  @@unique([quiz_id, teacher_id])
  @@index([teacher_id, updated_at(sort: Desc)])
  @@map("workshop_quiz_attempts")
}

model WorkshopQuizAnswer {
  id             String                    @id @default(uuid()) @db.Uuid
  attempt_id     String                    @db.Uuid
  question_id    String                    @db.Uuid
  answer         String
  is_correct     Boolean                   @default(false)
  grading_status WorkshopVideoAnswerStatus @default(AUTO_GRADED)
  grader_id      String?                   @db.Uuid
  graded_at      DateTime?
  feedback       String?
  created_at     DateTime                  @default(now())

  attempt  WorkshopQuizAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question WorkshopQuizQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
  grader   Profile?             @relation("WorkshopQuizAnswerGrader", fields: [grader_id], references: [id], onDelete: SetNull)

  @@unique([attempt_id, question_id])
  @@index([grading_status, created_at(sort: Desc)])
  @@map("workshop_quiz_answers")
}

model WorkshopRequirementCompletion {
  id             String   @id @default(uuid()) @db.Uuid
  requirement_id String   @db.Uuid
  teacher_id     String   @db.Uuid
  response       String?
  completed_at   DateTime @default(now())

  requirement WorkshopRequirement @relation(fields: [requirement_id], references: [id], onDelete: Cascade)
  teacher     Teacher             @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@unique([requirement_id, teacher_id])
  @@index([teacher_id, completed_at(sort: Desc)])
  @@map("workshop_requirement_completions")
}

model WorkshopCompletion {
  id           String   @id @default(uuid()) @db.Uuid
  workshop_id  String   @db.Uuid
  teacher_id   String   @db.Uuid
  completed_at DateTime @default(now())

  workshop Workshop @relation(fields: [workshop_id], references: [id], onDelete: Cascade)
  teacher  Teacher  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@unique([workshop_id, teacher_id])
  @@index([workshop_id, completed_at(sort: Desc)])
  @@map("workshop_completions")
}

model WorkshopAttendance {
  id            String                   @id @default(uuid()) @db.Uuid
  workshop_id   String                   @db.Uuid
  teacher_id    String                   @db.Uuid
  day_date      DateTime                 @db.Date
  checked_in_at DateTime                 @default(now())
  source        WorkshopAttendanceSource @default(QR)
  recorded_by   String?                  @db.Uuid

  workshop Workshop @relation(fields: [workshop_id], references: [id], onDelete: Cascade)
  teacher  Teacher  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  recorder Profile? @relation("WorkshopAttendanceRecorder", fields: [recorded_by], references: [id], onDelete: SetNull)

  // Same teacher can only be marked present once per day per workshop.
  @@unique([workshop_id, teacher_id, day_date])
  @@index([workshop_id, day_date])
  @@map("workshop_attendance")
}

// Rotating attendance code — admin generates one per day, teachers scan to
// check in. Kept as a table (not a computed value) so the admin can audit
// which codes were live on which day.
model WorkshopAttendanceCode {
  id          String   @id @default(uuid()) @db.Uuid
  workshop_id String   @db.Uuid
  code        String   @unique
  day_date    DateTime @db.Date
  created_by  String   @db.Uuid
  created_at  DateTime @default(now())

  workshop Workshop @relation(fields: [workshop_id], references: [id], onDelete: Cascade)
  author   Profile  @relation("WorkshopAttendanceCodeAuthor", fields: [created_by], references: [id])

  @@index([workshop_id, day_date(sort: Desc)])
  @@map("workshop_attendance_codes")
}

// ─── Workshop Videos — uploaded training videos with in-video quiz stops.
//     Each video has ordered MCQ/TF questions pinned to a timestamp; the
//     teacher-facing player pauses playback there until answered. Separate
//     "view" (did they watch it) and "attempt" (did they answer, and how
//     well) records, mirroring the attendance-vs-enrollment split above. ───
enum WorkshopVideoQuestionType {
  MCQ
  TF
  TEXT
}

enum WorkshopVideoAnswerStatus {
  AUTO_GRADED
  PENDING_REVIEW
  GRADED
}

model WorkshopVideo {
  id               String              @id @default(uuid()) @db.Uuid
  workshop_id      String              @db.Uuid
  title            String
  // Supabase objects have a storage path; Drive-backed videos have a Drive ID.
  storage_path     String?
  source_type      WorkshopVideoSource @default(SUPABASE)
  drive_file_id    String?
  url              String
  mime_type        String?
  size_bytes       Int?
  // Playback length, measured in the browser at upload time. Used to keep
  // question timestamps inside the video and to show duration in the UI.
  duration_seconds Int?
  order            Int                 @default(0)
  created_by       String              @db.Uuid
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt

  workshop  Workshop                @relation(fields: [workshop_id], references: [id], onDelete: Cascade)
  author    Profile                 @relation("WorkshopVideoAuthor", fields: [created_by], references: [id])
  questions WorkshopVideoQuestion[]
  views     WorkshopVideoView[]
  attempts  WorkshopVideoAttempt[]

  @@index([workshop_id, order])
  @@index([drive_file_id])
  @@map("workshop_videos")
}

enum WorkshopVideoSource {
  SUPABASE
  GOOGLE_DRIVE
}

model WorkshopVideoQuestion {
  id                String                    @id @default(uuid()) @db.Uuid
  video_id          String                    @db.Uuid
  type              WorkshopVideoQuestionType
  text              String
  // TF: "true"/"false". MCQ: the exact text of the correct option.
  correct_answer    String
  timestamp_seconds Int
  order             Int                       @default(0)
  created_at        DateTime                  @default(now())

  video   WorkshopVideo                 @relation(fields: [video_id], references: [id], onDelete: Cascade)
  options WorkshopVideoQuestionOption[]
  answers WorkshopVideoAnswer[]

  @@index([video_id, timestamp_seconds])
  @@map("workshop_video_questions")
}

model WorkshopVideoQuestionOption {
  id          String @id @default(uuid()) @db.Uuid
  question_id String @db.Uuid
  text        String
  order       Int

  question WorkshopVideoQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("workshop_video_question_options")
}

// One row per (video, teacher) — first/last time they pressed play and
// whether they watched it through to the end. Independent of whether they
// answered every question, same as WorkshopAttendance vs WorkshopEnrollment.
model WorkshopVideoView {
  id              String    @id @default(uuid()) @db.Uuid
  video_id        String    @db.Uuid
  teacher_id      String    @db.Uuid
  first_viewed_at DateTime  @default(now())
  last_viewed_at  DateTime  @default(now())
  completed_at    DateTime?

  video   WorkshopVideo @relation(fields: [video_id], references: [id], onDelete: Cascade)
  teacher Teacher       @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@unique([video_id, teacher_id])
  @@map("workshop_video_views")
}

// One row per (video, teacher), upserted as each in-video question is
// answered. `total` is fixed to the question count at answer-time so partial
// progress is visible before every question has been reached.
model WorkshopVideoAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  video_id     String    @db.Uuid
  teacher_id   String    @db.Uuid
  score        Int       @default(0)
  total        Int       @default(0)
  completed_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  video   WorkshopVideo         @relation(fields: [video_id], references: [id], onDelete: Cascade)
  teacher Teacher               @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  answers WorkshopVideoAnswer[]

  @@unique([video_id, teacher_id])
  @@map("workshop_video_attempts")
}

model WorkshopVideoAnswer {
  id             String                    @id @default(uuid()) @db.Uuid
  attempt_id     String                    @db.Uuid
  question_id    String                    @db.Uuid
  answer         String
  is_correct     Boolean                   @default(false)
  grading_status WorkshopVideoAnswerStatus @default(AUTO_GRADED)
  grader_id      String?                   @db.Uuid
  graded_at      DateTime?
  feedback       String?
  created_at     DateTime                  @default(now())

  attempt  WorkshopVideoAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question WorkshopVideoQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
  grader   Profile?              @relation("WorkshopVideoAnswerGrader", fields: [grader_id], references: [id], onDelete: SetNull)

  @@unique([attempt_id, question_id])
  @@index([grading_status, created_at(sort: Desc)])
  @@map("workshop_video_answers")
}

enum NotificationType {
  COMMUNITY_POST
  COMMUNITY_REPLY
  WORKSHOP_ANSWER
  WORKSHOP_MESSAGE
  WORKSHOP_VIDEO
  WORKSHOP_MATERIAL
  WORKSHOP_UPDATE
  WORKSHOP_LIVE
  WORKSHOP_NEW
  WORKSHOP_REQUEST
  WORKSHOP_REQUEST_DECISION
  SYSTEM
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  recipient_id String           @db.Uuid
  actor_id     String?          @db.Uuid
  type         NotificationType
  title_ar     String
  title_sq     String
  title_en     String
  body_ar      String?
  body_sq      String?
  body_en      String?
  href         String
  dedupe_key   String?          @unique
  read_at      DateTime?
  created_at   DateTime         @default(now())

  recipient Profile  @relation("NotificationRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)
  actor     Profile? @relation("NotificationActor", fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([recipient_id, read_at, created_at(sort: Desc)])
  @@map("notifications")
}
