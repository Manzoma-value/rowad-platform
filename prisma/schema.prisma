generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Maqsad {
  DEEN // الدين
  AQL // العقل
  NAFS // النفس
  NASL // النسل
  MAL // المال
}

// ─── النموذج التعليمي للرواد (Rowad Educational Model) ───

enum TeacherOnboardingStatus {
  PENDING_APPLICATION // signed up, must fill the application
  UNDER_REVIEW // application submitted, awaiting admin review
  WAITING_LIST // reviewed, kept pending for a later decision
  ACTIVE // application approved
  REJECTED // application rejected (terminal)
}

// ─── Teacher Application (replaces the Rowad stage onboarding) ───

enum Gender {
  MALE
  FEMALE
}

enum TeacherCurrentRole {
  TEACHER
  SUPERVISOR
  PRINCIPAL
  VICE_PRINCIPAL
  COUNSELOR
  TRAINER
  TEAM_LEAD
  RESEARCHER
  VOLUNTEER
  OTHER
}

enum QualificationLevel {
  DIPLOMA
  BACHELOR
  HIGHER_DIPLOMA
  MASTER
  PHD
}

enum ExperienceRange {
  LT_3
  Y_3_5
  Y_6_10
  Y_11_15
  GT_15
}

enum AchievementScope {
  INSTITUTIONAL
  CITY
  COUNTRY
  REGIONAL
  INTERNATIONAL
}

model TeacherApplication {
  id         String @id @default(uuid()) @db.Uuid
  teacher_id String @unique @db.Uuid
  school_id  String @db.Uuid

  // Personal
  full_name String
  age       Int
  country   String
  city      String
  phone     String
  email     String
  gender    Gender

  // Nomination
  nominating_entity String?
  nominator_name    String?
  nominator_role    String?

  // Current role
  current_role       TeacherCurrentRole
  current_role_other String?

  // Qualification
  qualification          QualificationLevel
  specialization         String
  graduation_institution String

  // Experience
  experience_areas       String[]
  experience_areas_other String?
  years_of_experience    ExperienceRange

  // Categories worked with
  target_groups       String[]
  target_groups_other String?

  // Contributions
  contributions String[]

  // Achievements
  has_achievements   Boolean           @default(false)
  achievements_scope AchievementScope?

  // Languages — JSON array: [{lang:"ar"|"en"|..., level:"BEGINNER"|...}, ...]
  languages       Json    @default("[]")
  languages_other String?

  // Optional attachments (the user just declares what they will bring)
  attachments String[]
  notes       String?

  // Review tracking
  submitted_at   DateTime  @default(now())
  reviewer_id    String?   @db.Uuid
  reviewer_notes String?
  reviewed_at    DateTime?

  teacher  Teacher  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  school   School   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  reviewer Profile? @relation("TeacherAppReviewedBy", fields: [reviewer_id], references: [id])

  @@index([school_id, submitted_at(sort: Desc)])
  @@map("teacher_applications")
}

enum RowadStage {
  STAGE1
  STAGE2
}

// ─── Owner Reports — formal institutional reports the platform owner
//     authors and assigns to a specific school. School admins of that
//     school can view (read-only). DRAFT → PUBLISHED. ───
enum OwnerReportStatus {
  DRAFT
  PUBLISHED
}

model OwnerReport {
  id           String            @id @default(uuid()) @db.Uuid
  school_id    String            @db.Uuid
  created_by   String            @db.Uuid
  title        String
  subtitle     String?
  description  String?
  report_date  DateTime?
  introduction String?
  closing_note String?
  status       OwnerReportStatus @default(DRAFT)
  // Ordered content blocks: [{ id, type: "TEXT"|"HEADING"|"HIGHLIGHT"|"BULLET_LIST", title?, body?, items?: string[] }]
  blocks       Json              @default("[]")
  // Image gallery: [{ url, path, caption? }]
  images       Json              @default("[]")
  // Downloadable files: [{ url, path, name, size?, mime? }]
  attachments  Json              @default("[]")
  // External links: [{ title, description?, url }]
  links        Json              @default("[]")
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
  published_at DateTime?

  school School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  author Profile @relation("OwnerReportAuthor", fields: [created_by], references: [id])

  @@index([school_id, status, published_at(sort: Desc)])
  @@index([status, updated_at(sort: Desc)])
  @@map("owner_reports")
}

// Per-session score for the card games. Game mode only — no admin
// approval, no gating. Owner sees per-user history; teacher/student
// also see their own best score in localStorage.
model RowadGameSubmission {
  id         String     @id @default(uuid()) @db.Uuid
  school_id  String     @db.Uuid
  profile_id String     @db.Uuid
  stage      RowadStage
  score      Int
  total      Int        @default(25)
  answers    Json?      @db.JsonB
  created_at DateTime   @default(now())

  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([school_id, created_at(sort: Desc)])
  @@index([profile_id, stage, score(sort: Desc)])
  @@map("rowad_game_submissions")
}

// The five practice mini-games on the Games page (Memory Match, Maqsad
// Hunter, Speed Drill, Maqsad Collector, Word Rain). Unlike the graded card
// game these have no answer key to validate server-side — every completed
// round is logged as-is purely so admins can see usage (who played, how
// often, which game is most popular). Never used for grading.
enum MiniGameKind {
  MEMORY
  HUNTER
  SPEED
  COLLECTOR
  WORDRAIN
}

model MiniGameSubmission {
  id         String       @id @default(uuid()) @db.Uuid
  school_id  String       @db.Uuid
  profile_id String       @db.Uuid
  game       MiniGameKind
  score      Int          @default(0)
  won        Boolean      @default(false)
  // Free-form per-game extras, e.g. {"moves":10,"time_seconds":42} or
  // {"best_combo":6}. Analytics-only — never validated.
  meta       Json?        @db.JsonB
  created_at DateTime     @default(now())

  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([school_id, created_at(sort: Desc)])
  @@index([profile_id, game, created_at(sort: Desc)])
  @@index([game, created_at(sort: Desc)])
  @@map("mini_game_submissions")
}

// In-progress card-game board — one row per (profile, stage), upserted on
// every autosave and deleted once that stage is actually submitted. Lets a
// player who navigates away mid-game (accidental back button, connectivity
// blip, phone lock) resume exactly where they left off instead of losing
// all 25 placements. Also gives admins visibility into who's mid-attempt.
model RowadGameDraft {
  id         String     @id @default(uuid()) @db.Uuid
  school_id  String     @db.Uuid
  profile_id String     @db.Uuid
  stage      RowadStage
  placements Json       @db.JsonB
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, stage])
  @@index([school_id, updated_at(sort: Desc)])
  @@map("rowad_game_drafts")
}

// One model per school — an editable copy of the 5×5 educational model.
// Used by the card-game (STAGE1 / STAGE2) — read-only for players.
model RowadModel {
  id         String   @id @default(uuid()) @db.Uuid
  school_id  String   @unique @db.Uuid
  title_ar   String   @default("النموذج التعليمي للرواد")
  title_sq   String?
  created_at DateTime @default(now())

  school   School         @relation(fields: [school_id], references: [id], onDelete: Cascade)
  levels   RowadLevel[]
  concepts RowadConcept[]

  @@map("rowad_models")
}

// The 5 rows (المستويات) — editable bilingual labels
model RowadLevel {
  id       String  @id @default(uuid()) @db.Uuid
  model_id String  @db.Uuid
  order    Int // 1..5
  name_ar  String
  name_sq  String?

  model RowadModel @relation(fields: [model_id], references: [id], onDelete: Cascade)

  @@unique([model_id, order])
  @@map("rowad_levels")
}

// The 25 concepts. Answer key = (maqsad = correct column) + (level = correct row)
model RowadConcept {
  id       String @id @default(uuid()) @db.Uuid
  model_id String @db.Uuid
  maqsad   Maqsad // correct column
  level    Int // correct row 1..5
  order    Int // order within the level

  // Stage 1 card / concept name
  name_ar         String
  name_sq         String?
  // المفهوم الاستراتيجي
  strategic_ar    String?
  strategic_sq    String?
  // الوصف
  description_ar  String?
  description_sq  String?
  // الواجب
  duty_ar         String?
  duty_sq         String?
  // الأجر
  reward_ar       String?
  reward_sq       String?
  // الثمرة
  fruit_ar        String?
  fruit_sq        String?
  // مؤشر التحقق
  verification_ar String?
  verification_sq String?

  created_at DateTime @default(now())

  model RowadModel @relation(fields: [model_id], references: [id], onDelete: Cascade)

  @@map("rowad_concepts")
}

model Invite {
  id    String     @id @default(uuid()) @db.Uuid
  token String     @unique
  type  InviteType

  school_id  String  @db.Uuid
  created_by String  @db.Uuid
  used_by    String? @db.Uuid

  is_active  Boolean   @default(true)
  use_count  Int       @default(0)
  max_uses   Int?
  expires_at DateTime?
  used_at    DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  school  School   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  creator Profile  @relation("InvitesCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)
  usedBy  Profile? @relation("InviteUsedBy", fields: [used_by], references: [id], onDelete: SetNull)

  @@map("invites")
}

enum InviteType {
  TEACHER
  STUDENT
  ADMIN
}

// One trait per Maqsad per stage (so max 5 traits per stage)
model StageTrait {
  id            String   @id @default(uuid()) @db.Uuid
  stage_id      String   @db.Uuid
  maqsad        Maqsad
  name          String // e.g. "الدراية"
  name_sq       String?
  definition    String? // e.g. "قدرة المستفيد على فهم سبب الفعل..."
  definition_sq String?
  created_at    DateTime @default(now())

  stage              RoadmapStage      @relation(fields: [stage_id], references: [id], onDelete: Cascade)
  elements           TraitElement[]
  module_main_traits RoadmapModule[]   @relation("ModuleMainTrait")
  module_links       ModuleTraitLink[]
  evaluations        TraitEvaluation[]

  @@unique([stage_id, maqsad]) // one trait per Maqsad per stage
  @@map("stage_traits")
}

// Assessment elements — visual guidance only, not scored individually
model TraitElement {
  id         String   @id @default(uuid()) @db.Uuid
  trait_id   String   @db.Uuid
  text       String // e.g. "يفهم المستفيد لماذا يتحرك"
  text_sq    String?
  order      Int
  created_at DateTime @default(now())

  trait StageTrait @relation(fields: [trait_id], references: [id], onDelete: Cascade)

  @@map("trait_elements")
}

// Link the main activating trait to a module
// Add this field to RoadmapModule:
// main_trait_id  String?  @db.Uuid
// main_trait     StageTrait? @relation("ModuleMainTrait", fields: [main_trait_id], references: [id])

// Teacher's trait evaluation after student completes a module
model TraitAssessment {
  id           String   @id @default(uuid()) @db.Uuid
  module_id    String   @db.Uuid
  student_id   String   @db.Uuid
  teacher_id   String   @db.Uuid
  general_note String?
  observed_at  DateTime @default(now())
  submitted_at DateTime @default(now())
  updated_at   DateTime @updatedAt

  module       RoadmapModule             @relation(fields: [module_id], references: [id], onDelete: Cascade)
  student      Student                   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  teacher      Teacher                   @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  trait_scores TraitEvaluation[]
  snapshots    TraitAssessmentSnapshot[]

  @@unique([module_id, student_id, teacher_id])
  @@index([module_id, student_id])
  @@map("trait_assessments")
}

// Immutable history for every educator submission. The parent assessment is
// the educator's current reading; snapshots preserve how that reading evolved
// as new actions and evidence were observed.
model TraitAssessmentSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  assessment_id String   @db.Uuid
  scores        Json
  general_note  String?
  observed_at   DateTime
  created_at    DateTime @default(now())

  assessment TraitAssessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@index([assessment_id, created_at(sort: Desc)])
  @@map("trait_assessment_snapshots")
}

// One score row per trait inside the assessment
model TraitEvaluation {
  id            String   @id @default(uuid()) @db.Uuid
  assessment_id String   @db.Uuid
  trait_id      String   @db.Uuid
  score         Float // e.g. 42.0 out of 50 for main, or 8.0 out of 12.5 for others
  note          String?
  created_at    DateTime @default(now())

  assessment TraitAssessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  trait      StageTrait      @relation(fields: [trait_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, trait_id]) // one score per trait per assessment
  @@map("trait_evaluations")
}

model Profile {
  id                           String                     @id @db.Uuid
  created_at                   DateTime                   @default(now())
  full_name                    String
  email                        String?                    @unique
  is_active                    Boolean                    @default(true)
  // True for read-only demo accounts (e.g. an investor account on the admin
  // role). The auth helpers refuse to authorise any write endpoint when this
  // is set; UI hides mutating buttons.
  is_view_only                 Boolean                    @default(false)
  // Optional hard expiry for a view-only school-admin account. Access is
  // denied at and after this instant, even if an old browser session exists.
  view_only_expires_at         DateTime?
  role                         Role
  reviewed_assessment_attempts AssessmentAttempt[]        @relation("AssessmentReviewedBy")
  school_admin_memberships     SchoolAdminMember[]
  student                      Student?
  teacher                      Teacher?
  posts                        Post[]
  post_reactions               PostReaction[]
  reviewedTeacherApplications  TeacherApplication[]       @relation("TeacherAppReviewedBy")
  reviewedLessons              Lesson[]                   @relation("LessonReviewedBy")
  reviewedQuizzes              Quiz[]                     @relation("QuizReviewedBy")
  rowadGameSubmissions         RowadGameSubmission[]
  miniGameSubmissions          MiniGameSubmission[]
  rowadGameDrafts              RowadGameDraft[]
  authoredOwnerReports         OwnerReport[]              @relation("OwnerReportAuthor")
  authoredTeacherGroups        TeacherGroup[]             @relation("TeacherGroupAuthor")
  authoredGroupAssessments     GroupAssessment[]          @relation("GroupAssessmentAuthor")
  authoredWorkshops            Workshop[]                 @relation("WorkshopAuthor")
  authoredWorkshopVideos       WorkshopVideo[]            @relation("WorkshopVideoAuthor")
  authoredWorkshopRequirements WorkshopRequirement[]      @relation("WorkshopRequirementAuthor")
  gradedWorkshopVideoAnswers   WorkshopVideoAnswer[]      @relation("WorkshopVideoAnswerGrader")
  gradedWorkshopQuizAnswers    WorkshopQuizAnswer[]       @relation("WorkshopQuizAnswerGrader")
  authoredAttendanceCodes      WorkshopAttendanceCode[]   @relation("WorkshopAttendanceCodeAuthor")
  workshopMessages             WorkshopMessage[]          @relation("WorkshopMessageAuthor")
  createdWorkshopEnrollments   WorkshopEnrollment[]       @relation("WorkshopEnrollmentAuthor")
  decidedWorkshopEnrollments   WorkshopEnrollment[]       @relation("WorkshopEnrollmentDecider")
  recordedWorkshopAttendance   WorkshopAttendance[]       @relation("WorkshopAttendanceRecorder")
  teacherGroupAnnouncements    TeacherGroupAnnouncement[]
  avatar_url                   String?
  avatar_path                  String?
  created_invites              Invite[]                   @relation("InvitesCreatedBy")
  used_invites                 Invite[]                   @relation("InviteUsedBy")
  notifications                Notification[]             @relation("NotificationRecipient")
  acted_notifications          Notification[]             @relation("NotificationActor")

  @@map("profiles")
}

model School {
  id                          String                     @id @default(uuid()) @db.Uuid
  /// Primary Arabic name (always required). Used as the canonical identifier.
  name                        String                     @unique
  /// Optional Latin-script name shown when the UI language is Albanian/English.
  /// Falls back to `name` if null.
  name_alt                    String?
  created_at                  DateTime                   @default(now())
  language                    String                     @default("ar")
  description                 String?
  slug                        String                     @unique @default("")
  color_bg                    String                     @default("#0B0B0C")
  color_primary               String                     @default("#ac8e52")
  color_secondary             String                     @default("#E5B93C")
  /// Whether this school is active. When false the owner has deactivated it:
  /// the subdomain landing shows a "deactivated" page and users cannot log in.
  is_active                   Boolean                    @default(true)
  /// Per-school feature toggles, e.g. { "hub": false, "lessons": true }.
  /// Empty object = all features on (see src/lib/features.ts for the resolver).
  /// JSON (not boolean columns) so new features ship without a migration.
  features                    Json                       @default("{}")
  announcements               Announcement[]
  assessmentAttempts          AssessmentAttempt[]
  assessments                 Assessment[]
  classes                     Class[]
  quizzes                     Quiz[]
  lessons                     Lesson[]
  roadmap                     Roadmap?
  rowad_model                 RowadModel?
  admins                      SchoolAdminMember[]
  students                    Student[]
  teachers                    Teacher[]
  teacher_applications        TeacherApplication[]
  posts                       Post[]
  invites                     Invite[]
  rowadGameSubmissions        RowadGameSubmission[]
  miniGameSubmissions         MiniGameSubmission[]
  rowadGameDrafts             RowadGameDraft[]
  owner_reports               OwnerReport[]
  teacher_groups              TeacherGroup[]
  workshops                   Workshop[]
  teacher_group_announcements TeacherGroupAnnouncement[]
  future_qualification_votes  FutureQualificationVote[]
  group_assessments           GroupAssessment[]

  @@map("schools")
}

/// Join table: a school can have many admins, an admin can manage many schools.
model SchoolAdminMember {
  id         String   @id @default(uuid()) @db.Uuid
  school_id  String   @db.Uuid
  profile_id String   @db.Uuid
  created_at DateTime @default(now())
  school     School   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  profile    Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([school_id, profile_id])
  @@map("school_admins")
}

model Teacher {
  id                               String                          @id @default(uuid()) @db.Uuid
  created_at                       DateTime                        @default(now())
  profile_id                       String                          @unique @db.Uuid
  school_id                        String                          @db.Uuid
  onboarding_status                TeacherOnboardingStatus         @default(PENDING_APPLICATION)
  // Server-side copy of an unfinished application, visible to the school
  // admin so they can follow progress before final submission.
  application_draft                Json?
  application_draft_updated_at     DateTime?
  // Workshop the teacher signed up via, if any (nullable — teachers can
  // still sign up outside of a workshop through the classic flow).
  workshop_signup_id               String?                         @db.Uuid
  workshop_signup                  Workshop?                       @relation("WorkshopSignedUpTeachers", fields: [workshop_signup_id], references: [id], onDelete: SetNull)
  workshop_enrollments             WorkshopEnrollment[]
  workshop_attendance              WorkshopAttendance[]
  workshop_video_views             WorkshopVideoView[]
  workshop_video_attempts          WorkshopVideoAttempt[]
  workshop_quiz_attempts           WorkshopQuizAttempt[]
  workshop_requirement_completions WorkshopRequirementCompletion[]
  workshop_completions             WorkshopCompletion[]
  announcements                    Announcement[]
  classes                          Class[]
  quizzes                          Quiz[]
  lessons                          Lesson[]
  profile                          Profile                         @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  school                           School                          @relation(fields: [school_id], references: [id], onDelete: Cascade)
  traitAssessments                 TraitAssessment[]
  application                      TeacherApplication?
  group_memberships                TeacherGroupMember[]
  ratings_given                    AssessmentRating[]              @relation("AssessmentRater")
  ratings_received                 AssessmentRating[]              @relation("AssessmentTarget")
  future_qualification_vote        FutureQualificationVote?

  @@index([school_id])
  @@map("teachers")
}

// ─── Teacher Groups — private teacher communities organized by admin.
//     A teacher can belong to many groups; a group has many teachers. ───
model FutureQualificationVote {
  id                      String        @id @default(uuid()) @db.Uuid
  teacher_id              String        @unique @db.Uuid
  school_id               String        @db.Uuid
  coaching_frequency      VoteFrequency
  consultation_frequency  VoteFrequency
  evaluation_frequency    VoteFrequency
  field_support_frequency VoteFrequency
  needs_group_leader      Boolean
  // Optional free-text comment the teacher may add alongside their answers.
  notes                   String?
  submitted_at            DateTime      @default(now())

  teacher Teacher @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id, submitted_at(sort: Desc)])
  @@map("future_qualification_votes")
}

enum VoteFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model TeacherGroup {
  id          String   @id @default(uuid()) @db.Uuid
  school_id   String   @db.Uuid
  name        String
  description String?
  created_by  String   @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  school           School                     @relation(fields: [school_id], references: [id], onDelete: Cascade)
  author           Profile                    @relation("TeacherGroupAuthor", fields: [created_by], references: [id])
  members          TeacherGroupMember[]
  assessments      GroupAssessment[]
  announcements    TeacherGroupAnnouncement[]
  // Additional groups an assessment targets, beyond its legacy `group_id`
  // primary group — lets one measurement model span several groups at once.
  assessment_links GroupAssessmentGroup[]

  @@index([school_id, updated_at(sort: Desc)])
  @@map("teacher_groups")
}

model TeacherGroupMember {
  group_id   String   @db.Uuid
  teacher_id String   @db.Uuid
  joined_at  DateTime @default(now())

  group   TeacherGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  teacher Teacher      @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@id([group_id, teacher_id])
  @@index([teacher_id])
  @@map("teacher_group_members")
}

// ─── Measurement models — peer scoring inside one or more teacher groups.
//     Each model owns its own ordered set of traits (AssessmentTrait) that
//     the admin fully authors per model — label, rating statement, color.
//     Every member distributes 100 points across that model's traits for
//     every target in scope (their groups' combined membership, including
//     themselves). Always-live updates; admin can close to lock the
//     snapshot. The five-column layout below predates per-model traits and
//     is kept only for historical rollback safety — the app reads/writes
//     `AssessmentRating.scores` exclusively. ───
enum GroupAssessmentStatus {
  OPEN
  CLOSED
}

enum AssessmentTraitKind {
  TARGET
  EARLY_OBSERVATION
}

model GroupAssessment {
  id         String                @id @default(uuid()) @db.Uuid
  // Legacy "primary group" pointer — the first group selected at creation.
  // Superseded by `target_groups` for member sourcing, kept for back-compat.
  group_id   String                @db.Uuid
  school_id  String                @db.Uuid
  created_by String                @db.Uuid
  title      String
  status     GroupAssessmentStatus @default(OPEN)
  created_at DateTime              @default(now())
  updated_at DateTime              @updatedAt
  closed_at  DateTime?

  group         TeacherGroup           @relation(fields: [group_id], references: [id], onDelete: Cascade)
  school        School                 @relation(fields: [school_id], references: [id], onDelete: Cascade)
  author        Profile                @relation("GroupAssessmentAuthor", fields: [created_by], references: [id])
  ratings       AssessmentRating[]
  traits        AssessmentTrait[]
  target_groups GroupAssessmentGroup[]

  @@index([group_id, created_at(sort: Desc)])
  @@index([school_id])
  @@map("group_assessments")
}

// One row per group this model draws members/targets from. A model with a
// single row behaves exactly like the old single-group design; the admin
// can pick several groups (or all of them) at creation.
model GroupAssessmentGroup {
  assessment_id String @db.Uuid
  group_id      String @db.Uuid

  assessment GroupAssessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  group      TeacherGroup    @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@id([assessment_id, group_id])
  @@index([group_id])
  @@map("group_assessment_groups")
}

// One row per trait the admin defined for this specific model, in the
// order the 100-point distributor and every report renders them.
// `position` is the stable index used to align AssessmentRating.scores.
model AssessmentTrait {
  id            String              @id @default(uuid()) @db.Uuid
  assessment_id String              @db.Uuid
  position      Int
  label_ar      String
  label_sq      String
  statement_ar  String
  statement_sq  String
  color         String              @default("#6B1E2D")
  kind          AssessmentTraitKind @default(TARGET)
  objective_ar  String?
  objective_sq  String?
  created_at    DateTime            @default(now())

  assessment GroupAssessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, position])
  @@index([assessment_id])
  @@map("assessment_traits")
}

model AssessmentRating {
  assessment_id     String   @db.Uuid
  rater_teacher_id  String   @db.Uuid
  target_teacher_id String   @db.Uuid
  // LEGACY five-column layout — superseded by `scores` below. Left in place
  // (unused by the app) purely so a historical row is never destructively
  // altered; do not read or write these from application code.
  s_lineage         Int
  s_atonement       Int
  s_awareness       Int
  s_zeal            Int
  s_distinct        Int
  // Ordered scores aligned to this assessment's AssessmentTrait.position —
  // length equals the model's trait count, sums to 100.
  scores            Json
  updated_at        DateTime @updatedAt

  assessment GroupAssessment            @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  rater      Teacher                    @relation("AssessmentRater", fields: [rater_teacher_id], references: [id], onDelete: Cascade)
  target     Teacher                    @relation("AssessmentTarget", fields: [target_teacher_id], references: [id], onDelete: Cascade)
  revisions  AssessmentRatingRevision[]

  @@id([assessment_id, rater_teacher_id, target_teacher_id])
  @@index([assessment_id, target_teacher_id])
  @@index([assessment_id, rater_teacher_id])
  @@map("assessment_ratings")
}

// An immutable snapshot of the score array that was replaced after the
// current rating had remained unchanged for at least 24 hours. Changes made
// inside the first 24 hours refine the same working reading and do not create
// audit noise; later changes preserve the prior reading for administrators.
model AssessmentRatingRevision {
  id                  String   @id @default(uuid()) @db.Uuid
  assessment_id       String   @db.Uuid
  rater_teacher_id    String   @db.Uuid
  target_teacher_id   String   @db.Uuid
  scores              Json
  replacement_scores  Json
  original_updated_at DateTime
  archived_at         DateTime @default(now())

  rating AssessmentRating @relation(fields: [assessment_id, rater_teacher_id, target_teacher_id], references: [assessment_id, rater_teacher_id, target_teacher_id], onDelete: Cascade)

  @@unique([assessment_id, rater_teacher_id, target_teacher_id, original_updated_at])
  @@index([assessment_id, archived_at(sort: Desc)])
  @@index([rater_teacher_id, target_teacher_id, archived_at(sort: Desc)])
  @@map("assessment_rating_revisions")
}

// Private announcement feed inside a teacher group. Authors can be school
// admins or teacher members; visibility is enforced by the API routes.
model TeacherGroupAnnouncement {
  id         String   @id @default(uuid()) @db.Uuid
  group_id   String   @db.Uuid
  school_id  String   @db.Uuid
  author_id  String   @db.Uuid
  content    String
  created_at DateTime @default(now())

  group  TeacherGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  school School       @relation(fields: [school_id], references: [id], onDelete: Cascade)
  author Profile      @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@index([group_id, created_at(sort: Desc)])
  @@index([author_id])
  @@map("teacher_group_announcements")
}

model Student {
  id                  String                  @id @default(uuid()) @db.Uuid
  class_id            String?                 @db.Uuid
  created_at          DateTime                @default(now())
  onboarding_status   StudentOnboardingStatus @default(PENDING_INTAKE)
  profile_id          String                  @unique @db.Uuid
  school_id           String?                 @db.Uuid
  city                String?
  age                 Int?
  assessment_attempts AssessmentAttempt[]
  moduleAttempts      ModuleAttempt[]
  quiz_attempts       QuizAttempt[]
  lesson_attempts     LessonAttempt[]
  class               Class?                  @relation(fields: [class_id], references: [id])
  profile             Profile                 @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  school              School?                 @relation(fields: [school_id], references: [id])
  traitAssessments    TraitAssessment[]

  @@index([school_id])
  @@index([class_id])
  @@index([school_id, onboarding_status])
